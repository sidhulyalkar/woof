{
  "name": "woof-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Woof - relationship-first dogOS companion for shared activities, longitudinal context, and trustworthy personalization",
  "author": "Sidharth Hulyalkar",
  "license": "MIT",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "type-check": "pnpm --filter @woof/api exec tsc --noEmit && pnpm --filter @woof/web type-check && pnpm --filter @woof/mobile exec tsc --noEmit",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "verify": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm build",
    "db:migrate": "turbo db:migrate",
    "db:seed": "turbo db:seed",
    "db:studio": "pnpm --filter @woof/database db:studio",
    "artifact": "node scripts/create-artifact.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.11.5",
    "prettier": "^3.2.4",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.1",
  "pnpm": {
    "overrides": {
      "lodash": "4.18.0",
      "js-yaml": "4.3.2",
      "@xmldom/xmldom": "0.8.15",
      "postcss": "8.5.18",
      "multer": "2.5.0",
      "fast-uri": "3.1.7",
      "body-parser": "1.20.9",
      "brace-expansion@1.1.18": "1.1.21",
      "brace-expansion@2.1.4": "2.1.7",
      "brace-expansion@5.0.9": "5.0.12",
      "compression": "1.8.2",
      "engine.io": "6.6.10",
      "metro": "0.83.8",
      "node-forge": "1.4.4",
      "proxy-addr": "2.0.8",
      "shell-quote": "1.11.0",
      "source-map-js": "1.2.2",
      "undici": "6.29.1"
    }
  }
}
