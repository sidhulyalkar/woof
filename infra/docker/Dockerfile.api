# Multi-stage production image for the Woof API.
ARG NODE_VERSION=20.20.2
ARG PNPM_VERSION=8.15.1

FROM node:${NODE_VERSION}-alpine AS builder
ARG PNPM_VERSION

RUN apk add --no-cache openssl libc6-compat \
  && npm install --global pnpm@${PNPM_VERSION}

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/api ./apps/api

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @woof/database db:generate
RUN pnpm --filter @woof/api build

FROM node:${NODE_VERSION}-alpine AS runner
ARG PNPM_VERSION

RUN apk add --no-cache openssl libc6-compat \
  && npm install --global pnpm@${PNPM_VERSION}

WORKDIR /app

# Keep the workspace metadata and database package available so Fly's release
# command can apply committed Prisma migrations before new Machines receive traffic.
# The runtime workspace belongs to the unprivileged node user because Prisma's
# migration engine may need writable package-local runtime state while resolving
# its native engine. The container never needs to become root after image build.
COPY --chown=node:node package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY --chown=node:node --from=builder /app/apps/api/dist ./apps/api/dist
COPY --chown=node:node --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/packages ./packages

ENV NODE_ENV=production
ENV PORT=4000
ENV NODE_OPTIONS=--enable-source-maps

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:4000/api/v1/ops/health/live', (r) => { r.resume(); process.exit(r.statusCode === 200 ? 0 : 1); }).on('error', () => process.exit(1))"

USER node

CMD ["node", "apps/api/dist/main"]
