# Woof API Configuration

# Server
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/woof?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:password@localhost:5432/woof_shadow?schema=public"

# JWT
# Development only. Replace with: openssl rand -hex 32
JWT_SECRET=dev-woof-jwt-secret-replace-before-any-shared-deployment-1234567890
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# File Upload
MAX_FILE_SIZE=10485760

# Redis (optional)
REDIS_URL=redis://localhost:6379

# External APIs (optional)
GOOGLE_MAPS_API_KEY=
APPLE_HEALTH_CLIENT_ID=
GOOGLE_FIT_CLIENT_ID=

# Pet Health Lens multimodal screening (optional)
# When absent, emergency text screening still works and image interpretation fails closed.
OPENAI_API_KEY=
OPENAI_HEALTH_MODEL=gpt-5.6-luna
OPENAI_HEALTH_TIMEOUT_MS=12000

# Monitoring (optional)
SENTRY_DSN=

# Storage (S3/R2, optional for local development)
S3_ENDPOINT=
S3_BUCKET=woof-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
AWS_REGION=auto

# Web Push
# Generate a fresh VAPID pair for each environment. Never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# n8n Webhook Authentication
# Use a random secret in deployed environments.
N8N_WEBHOOK_SECRET=
