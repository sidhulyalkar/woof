# Woof API Configuration

# Server
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Keep Swagger disabled in shared/production environments unless explicitly needed.
API_DOCS_ENABLED=false

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/woof?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:password@localhost:5432/woof_shadow?schema=public"

# JWT
# Development only. Replace with: openssl rand -hex 32
JWT_SECRET=dev-woof-jwt-secret-replace-before-any-shared-deployment-1234567890
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Feature rollouts
# Experimental product surfaces default on outside production and disappear when disabled.
ENABLE_ADVENTURE_SYSTEM=true
ENABLE_DOGOS_AUTOPILOT=true
ENABLE_DOGOS_OUR_STORY=true
ENABLE_DOGOS_CONNECTORS=true
ENABLE_DOGOS_CONCIERGE=true

# dogOS connector credential vault.
# Generate 32 random bytes and encode them as base64, for example:
# openssl rand -base64 32
# Required when ENABLE_DOGOS_CONNECTORS=true in production. Do not reuse JWT/VAPID keys.
CONNECTOR_CREDENTIALS_KEY=

# Operational metrics access is fail-closed when this is absent.
# Generate a distinct secret, for example: openssl rand -hex 32
# Do not reuse JWT, VAPID, webhook, or connector encryption credentials.
OPS_METRICS_TOKEN=

# File Upload
MAX_FILE_SIZE=10485760

# Redis (optional)
REDIS_URL=redis://localhost:6379

# External APIs (optional)
GOOGLE_MAPS_API_KEY=
APPLE_HEALTH_CLIENT_ID=
GOOGLE_FIT_CLIENT_ID=

# Concierge intentionally has no live-weather setting in v1. Until a verified
# weather transport is added, its API returns weather.status=NOT_CONFIGURED.

# Pet Health Lens multimodal screening (optional)
# When absent, emergency text screening still works and image interpretation fails closed.
OPENAI_API_KEY=
OPENAI_HEALTH_MODEL=gpt-5.6-luna
OPENAI_HEALTH_TIMEOUT_MS=12000

# Specialized behavior-video worker (optional)
# Recommended production deployment: private service network + bearer token.
# Woof fails closed when this worker is absent; it does not invent video observations.
BEHAVIOR_VISION_SERVICE_URL=
BEHAVIOR_VISION_SERVICE_TOKEN=
BEHAVIOR_VISION_TIMEOUT_MS=45000

# Monitoring (optional)
# Backend error telemetry is scrubbed of request headers, query strings, user identity,
# breadcrumb payloads, and span data before egress.
SENTRY_DSN=

# Storage (S3/R2, optional for local development)
# S3_PUBLIC_URL is needed only for the legacy/public social media path.
# The private pet library uses signed URLs and works without a public bucket URL.
S3_ENDPOINT=
S3_BUCKET=woof-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
AWS_REGION=auto

# Private pet-media limits. Defaults shown here are production-safe starting points.
MEDIA_LIBRARY_IMAGE_MAX_BYTES=26214400
MEDIA_LIBRARY_VIDEO_MAX_BYTES=524288000
MEDIA_LIBRARY_USER_QUOTA_BYTES=10737418240

# Private media derivative worker.
# Install ffmpeg + ffprobe in production images before enabling this worker.
# Originals stay immutable; generated thumbnails/posters/previews strip source metadata.
MEDIA_DERIVATIVES_ENABLED=false
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_FFPROBE_PATH=ffprobe

# Web Push
# Generate a fresh VAPID pair for each environment. Never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# n8n Webhook Authentication
# Use a random secret in deployed environments.
N8N_WEBHOOK_SECRET=
